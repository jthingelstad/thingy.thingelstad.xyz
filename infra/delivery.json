{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "thingy.thingelstad.xyz GitHub OIDC publication from main only",
  "Parameters": {
    "SiteBucket": {
      "Type": "String",
      "AllowedPattern": "[a-z0-9.-]+"
    },
    "DistributionId": {
      "Type": "String",
      "AllowedPattern": "[A-Z0-9]+"
    }
  },
  "Resources": {
    "DeploymentRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "Description": "Publishes the verified main build of thingy.thingelstad.xyz",
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Federated": {
                  "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:oidc-provider/token.actions.githubusercontent.com"
                }
              },
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                  "token.actions.githubusercontent.com:sub": "repo:jthingelstad@5351/thingy.thingelstad.xyz@1442336868:ref:refs/heads/main"
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "SiteDelivery",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${SiteBucket}"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": ["s3:GetObject", "s3:PutObject"],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${SiteBucket}/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "cloudfront:CreateInvalidation",
                    "cloudfront:GetInvalidation",
                    "cloudfront:GetDistribution"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${DistributionId}"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "DeploymentRoleArn": {
      "Value": {
        "Fn::GetAtt": ["DeploymentRole", "Arn"]
      },
      "Description": "GitHub OIDC deployment identity (repository variable AWS_DEPLOY_ROLE_ARN)"
    }
  }
}
