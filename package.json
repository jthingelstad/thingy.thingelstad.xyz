{
  "name": "thingy-character-home",
  "version": "0.1.0",
  "private": true,
  "license": "CC-BY-NC-4.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && vite build --config vite.widget.config.ts && node tools/write-site-files.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build && node tools/validate-assets.mjs && node tools/validate-site.mjs",
    "test:browser": "playwright test",
    "assets:prepare": "python3 tools/prepare_stills.py && node tools/optimize-assets.mjs",
    "infra:plan": "node tools/infra.mjs plan",
    "infra:apply": "node tools/infra.mjs apply",
    "deploy": "node tools/deploy.mjs",
    "validate:site": "node tools/validate-site.mjs"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "3.1152.0",
    "@aws-sdk/client-cloudfront": "3.1152.0",
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/client-sts": "3.1152.0",
    "@gltf-transform/cli": "4.5.1",
    "@playwright/test": "1.64.1",
    "@types/three": "0.187.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "overrides": {
    "@donmccurdy/caporal": {
      "glob": "^14.0.2"
    }
  }
}
