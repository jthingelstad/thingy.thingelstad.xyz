  "runtimeMaterials": {
    "beacon": "Thingy_Beacon",
    "face": "Thingy_Face"
  },
  "notes": "A web derivative of the v0.15 character: the cloth is baked on to a lighter body, the screen shows one cell of the face atlas, and each accessory is its own mesh, named Thingy_Accessory_<id>, so a page can show or hide it. A slot gives what a scene can have with it, and an accessory's `absent` mesh takes its place when it comes off. faces.webp is the same atlas, small, for a page that offers the faces. This is not a printable model.",
  "toolPoses": {
    "carry": {
      "label": "Carry",
      "stillFrame": 1
    },
    "show": {
      "label": "Show",
      "stillFrame": 1
    },
    "work": {
      "label": "Work",
      "stillFrame": 1
    }
  },
